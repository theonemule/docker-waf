ADMIN_USER=admin
ADMIN_PASSWORD=replace-with-a-long-random-password
ACME_EMAIL=
TZ=UTC
LITEEDGE_VERSION=latest
LITEEDGE_REPO=theonemule/docker-waf
LITEEDGE_UID=1000
LITEEDGE_GID=1000

# Optional: expose the admin UI over HTTP only. Leave disabled in normal deployments.
LITEEDGE_ADMIN_HTTP_ONLY=0

# Management is bound to loopback unless explicitly given the server's private LAN IP.
LITEEDGE_ADMIN_BIND_IP=127.0.0.1
LITEEDGE_ADMIN_EXTERNAL_PORT=8443
