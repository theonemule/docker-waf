+/*
+ * LiteEdge: cache explicitly shared file rulesets for this HTTP config
+ * cycle only. Normal modsecurity_rules_file and parent inheritance retain
+ * upstream semantics. Each location has its own RulesSet (properties and
+ * exclusions); libmodsecurity merge shares compiled rule objects.
+ */
+typedef struct {
+    ngx_str_t path;
+    ngx_http_modsecurity_conf_t *conf;
+} ngx_http_modsecurity_shared_entry_t;
+
+static char *
+ngx_conf_set_shared_rules_file(ngx_conf_t *cf, ngx_command_t *cmd, void *conf)
+{
+    ngx_http_modsecurity_conf_t *mcf = conf;
+    ngx_http_modsecurity_main_conf_t *mmcf;
+    ngx_http_modsecurity_shared_entry_t *entries, *entry;
+    ngx_http_modsecurity_conf_t *shared = NULL;
+    ngx_str_t *value = cf->args->elts;
+    ngx_uint_t i;
+    ngx_pool_t *old_pool;
+    const char *error = NULL;
+    char *path;
+    int res;
+
+    mmcf = ngx_http_conf_get_module_main_conf(cf, ngx_http_modsecurity_module);
+    if (mmcf->shared_rules == NULL) {
+        mmcf->shared_rules = ngx_array_create(cf->pool, 4,
+                                      sizeof(ngx_http_modsecurity_shared_entry_t));
+        if (mmcf->shared_rules == NULL) {
+            return NGX_CONF_ERROR;
+        }
+    }
+    entries = mmcf->shared_rules->elts;
+    for (i = 0; i < mmcf->shared_rules->nelts; i++) {
+        if (entries[i].path.len == value[1].len &&
+            ngx_memcmp(entries[i].path.data, value[1].data, value[1].len) == 0) {
+            shared = entries[i].conf;
+            mmcf->shared_hits++;
+            break;
+        }
+    }
+    if (shared == NULL) {
+        path = ngx_str_to_char(value[1], cf->pool);
+        if (path == (char *) -1) {
+            return NGX_CONF_ERROR;
+        }
+        /* Reuse upstream creation/cleanup, including PCRE allocation context. */
+        shared = ngx_http_modsecurity_create_conf(cf);
+        if (shared == NULL || shared == NGX_CONF_ERROR) {
+            return NGX_CONF_ERROR;
+        }
+        old_pool = ngx_http_modsecurity_pcre_malloc_init(cf->pool);
+        res = msc_rules_add_file(shared->rules_set, path, &error);
+        ngx_http_modsecurity_pcre_malloc_done(old_pool);
+        if (res < 0) {
+            ngx_conf_log_error(NGX_LOG_EMERG, cf, 0,
+                               "shared ModSecurity file %s: %s", path, error);
+            return NGX_CONF_ERROR;
+        }
+        entry = ngx_array_push(mmcf->shared_rules);
+        if (entry == NULL) {
+            return NGX_CONF_ERROR;
+        }
+        entry->path = value[1];
+        entry->conf = shared;
+        mmcf->rules_file += res;
+    }
+    old_pool = ngx_http_modsecurity_pcre_malloc_init(cf->pool);
+    res = msc_rules_merge(mcf->rules_set, shared->rules_set, &error);
+    ngx_http_modsecurity_pcre_malloc_done(old_pool);
+    if (res < 0) {
+        ngx_conf_log_error(NGX_LOG_EMERG, cf, 0,
+                           "shared ModSecurity merge: %s", error);
+        return NGX_CONF_ERROR;
+    }
+    return NGX_CONF_OK;
+}
+
